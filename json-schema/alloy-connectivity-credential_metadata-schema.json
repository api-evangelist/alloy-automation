{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.runalloy.com/schemas/alloy-connectivity-credential_metadata-schema.json",
  "title": "CredentialMetadata",
  "type": "object",
  "description": "Authentication requirements for a connector",
  "properties": {
    "connectorId": {
      "type": "string",
      "description": "Connector identifier"
    },
    "authType": {
      "type": "string",
      "description": "Authentication type required",
      "enum": [
        "oauth2",
        "api_key",
        "basic"
      ]
    },
    "requiredFields": {
      "type": "array",
      "description": "Fields required to create credentials",
      "items": {
        "type": "object"
      }
    }
  }
}