{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.runalloy.com/schemas/alloy-connectivity-credential-schema.json",
  "title": "Credential",
  "type": "object",
  "description": "A stored credential for a user's connector",
  "properties": {
    "credentialId": {
      "type": "string",
      "description": "Unique identifier for the credential"
    },
    "connectorId": {
      "type": "string",
      "description": "Connector this credential belongs to"
    },
    "userId": {
      "type": "string",
      "description": "User this credential belongs to"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the credential was created"
    }
  }
}