{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://docs.runalloy.com/structures/alloy-connectivity-connector_action-structure.json",
  "title": "ConnectorAction",
  "type": "object",
  "description": "A specific action available for a connector",
  "properties": {
    "actionId": {
      "type": "xs:string",
      "description": "Unique identifier for the action"
    },
    "name": {
      "type": "xs:string",
      "description": "Display name of the action"
    },
    "description": {
      "type": "xs:string",
      "description": "Description of what the action does"
    },
    "parameters": {
      "type": "array",
      "description": "Parameters accepted by this action"
    }
  }
}