{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://docs.runalloy.com/structures/alloy-connectivity-credential-structure.json",
  "title": "Credential",
  "type": "object",
  "description": "A stored credential for a user's connector",
  "properties": {
    "credentialId": {
      "type": "xs:string",
      "description": "Unique identifier for the credential"
    },
    "connectorId": {
      "type": "xs:string",
      "description": "Connector this credential belongs to"
    },
    "userId": {
      "type": "xs:string",
      "description": "User this credential belongs to"
    },
    "createdAt": {
      "type": "xs:string",
      "description": "Timestamp when the credential was created"
    }
  }
}