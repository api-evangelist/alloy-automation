{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://docs.runalloy.com/structures/alloy-connectivity-credential_metadata-structure.json",
  "title": "CredentialMetadata",
  "type": "object",
  "description": "Authentication requirements for a connector",
  "properties": {
    "connectorId": {
      "type": "xs:string",
      "description": "Connector identifier"
    },
    "authType": {
      "type": "xs:string",
      "description": "Authentication type required"
    },
    "requiredFields": {
      "type": "array",
      "description": "Fields required to create credentials"
    }
  }
}