{
  "opencollection": "1.0.0",
  "info": {
    "name": "Alloy Automation Embedded & Unified Connectivity Events API",
    "version": "2024-03"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://embedded.runalloy.com/2024-03/events",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "query"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Opaque pagination cursor from a prior pageInfo."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of records to return per page."
              }
            ]
          },
          "docs": "Lists execution and provider events for observability. Supports pagination via cursor."
        },
        {
          "info": {
            "name": "Retrieve an event",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://embedded.runalloy.com/2024-03/events/:eventId",
            "params": [
              {
                "name": "eventId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve an event"
        }
      ]
    }
  ],
  "bundled": true
}