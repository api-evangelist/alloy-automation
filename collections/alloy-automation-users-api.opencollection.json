{
  "opencollection": "1.0.0",
  "info": {
    "name": "Alloy Automation Embedded & Unified Connectivity Users API",
    "version": "2024-03"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://embedded.runalloy.com/2024-03/users"
          },
          "docs": "Lists the end-user records in your Alloy account."
        },
        {
          "info": {
            "name": "Create a user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://embedded.runalloy.com/2024-03/users",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates an end-user record in Alloy and returns its userId."
        },
        {
          "info": {
            "name": "Retrieve a single user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://embedded.runalloy.com/2024-03/users/:userId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "The Alloy end-user record ID."
              }
            ]
          },
          "docs": "Retrieve a single user"
        },
        {
          "info": {
            "name": "Delete a user",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://embedded.runalloy.com/2024-03/users/:userId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "The Alloy end-user record ID."
              }
            ]
          },
          "docs": "Delete a user"
        }
      ]
    }
  ],
  "bundled": true
}